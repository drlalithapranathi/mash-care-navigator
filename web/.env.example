# Copy to web/.env.local and fill in. Vite exposes only VITE_-prefixed vars.
# The client ID is not a secret, but keep it out of committed source.

# Non-production client ID from https://fhir.epic.com -> Build Apps.
# Left blank, launch.html shows a "set this" message instead of launching.
VITE_EPIC_CLIENT_ID=

# Epic R4 sandbox FHIR base (also the OAuth `aud`, and the standalone `iss`).
VITE_EPIC_FHIR_BASE=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4

# Optional: override the requested scopes. If unset, launch.js auto-selects
# `launch/patient …` for standalone and `launch …` for EHR launch.
# VITE_EPIC_SCOPE=openid fhirUser launch/patient patient/Patient.read patient/Observation.read patient/Condition.read
