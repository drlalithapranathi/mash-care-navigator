# Copy to openmrs/.env and fill in real values. The .env file is gitignored.
#
# --- docker-compose (openmrs/deploy/docker-compose.yml) ---
# DB passwords are NOT set here — they live in file-based Docker secrets so they
# never land in container env. See openmrs/deploy/secrets/README.md (#33).
VIRTUAL_HOST=
LETSENCRYPT_EMAIL=
MYSQL_DB=openmrs
MYSQL_USER=openmrs
OPENMRS_VERSION=demo

# --- seed-concepts.sh ---
OPENMRS_BASE_URL=
OPENMRS_USER=
OPENMRS_PASSWORD=
