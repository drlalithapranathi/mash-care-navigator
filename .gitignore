# Dependencies / build output
node_modules/
dist/
build/
*.log
npm-debug.log*
coverage/

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp
*.local

# Claude Code scratch/drop-zone — never commit
.claude/

# Secrets / env / keys
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*

# Docker secrets — commit only the .example templates + README (#33)
openmrs/deploy/secrets/*
!openmrs/deploy/secrets/*.example
!openmrs/deploy/secrets/README.md

# Widget OMOD build inputs/outputs (#28) — reproduced from git via `make omod`
openmrs/deploy/*.omod

# Never commit anywhere: PDFs and Office docs (reference/study material)
*.pdf
*.docx
*.doc
*.pptx

# Never commit at repo root: screenshots, scratch images
/*.png
/*.jpg
/*.jpeg
/*.gif
/Screenshot*

# Allow committed images only under docs/
!docs/*.png
!docs/*.svg
!docs/*.jpg