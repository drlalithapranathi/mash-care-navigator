# Never commit at repo root: PDFs, screenshots, scratch images
/*.pdf
/*.png
/*.jpg
/*.jpeg
/*.gif
/Screenshot*

# Allow committed images only under docs/
!docs/*.png
!docs/*.svg
!docs/*.jpg